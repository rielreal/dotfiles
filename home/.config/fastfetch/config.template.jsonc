{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty-direct",
    "source": "{{logo}}",
    "width": 30,
    "height": 14,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "{{petal}}",
      "title": "{{ember}}",
      "output": "{{text}}"
    },
    "key": {
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "{{petal}}",
        "at": "{{muted}}",
        "host": "{{ember}}"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{rule}}m────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 os",
      "keyColor": "{{petal}}",
      "format": "{name}"
    },
    {
      "type": "kernel",
      "key": " kernel",
      "keyColor": "{{petal}}",
      "format": "{release}"
    },
    {
      "type": "wm",
      "key": "󱗃 wm",
      "keyColor": "{{ember}}",
      "format": "{pretty-name} {version}"
    },
    {
      "type": "terminal",
      "key": " term",
      "keyColor": "{{ember}}",
      "format": "{pretty-name}"
    },
    {
      "type": "shell",
      "key": " shell",
      "keyColor": "{{ember}}",
      "format": "{pretty-name}"
    },
    {
      "type": "packages",
      "key": "󰏗 pkgs",
      "keyColor": "{{ember}}",
      "format": "{all}"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;{{rule}}m────────────────────────────"
    },
    {
      "type": "cpu",
      "key": " cpu",
      "keyColor": "{{gold}}",
      "format": "{name}",
      "temp": false
    },
    {
      "type": "gpu",
      "key": "󰢮 gpu",
      "keyColor": "{{gold}}",
      "hideType": "integrated",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": " ram",
      "keyColor": "{{gold}}",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": "󰋊 home",
      "keyColor": "{{gold}}",
      "folders": "/home",
      "format": "{size-used} / {size-total}"
    },
    {
      "type": "uptime",
      "key": "󰅐 up",
      "keyColor": "{{blush}}"
    }
  ]
}
