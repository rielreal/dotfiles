#!/usr/bin/env bash
set -euo pipefail

choice=$(printf '%s\n' Lock Logout Suspend Reboot Shutdown | rofi -dmenu -i -p power) || exit 0

case "$choice" in
    Lock) loginctl lock-session ;;
    Logout) uwsm stop ;;
    Suspend) systemctl suspend ;;
    Reboot) systemctl reboot ;;
    Shutdown) systemctl poweroff ;;
esac
