#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir="$(xdg-user-dir PICTURES)/Wallpapers"
current_link="${XDG_STATE_HOME:-$HOME/.local/state}/wallpaper"

list_wallpapers() {
    find "$wallpaper_dir" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' -o -iname '*.gif' -o -iname '*.webp' \) \
        -printf '%f\n' | sort |
        while IFS= read -r name; do
            printf '%s\0icon\x1f%s\n' "$name" "$wallpaper_dir/$name"
        done
}

choice=$(list_wallpapers | rofi -dmenu -i -p wallpaper -show-icons \
    -theme-str 'window { width: 70%; } mainbox { children: [listbox]; } listview { columns: 4; lines: 3; } element { orientation: vertical; } element-icon { size: 9em; } element-text { horizontal-align: 0.5; }') || exit 0
[[ -n "$choice" ]] || exit 0

awww img "$wallpaper_dir/$choice" --transition-type grow --transition-fps 60
ln -sfn "$wallpaper_dir/$choice" "$current_link"
"$(dirname "$0")/wallpaper-colors" "$wallpaper_dir/$choice"
