def closest_folder_color(accent):
    degrees = accent.hue * 360
    def distance(name):
        gap = abs(PAPIRUS_FOLDER_HUES[name] - degrees)
        return min(gap, 360 - gap)
    return min(PAPIRUS_FOLDER_HUES, key=distance)


def render_folder_theme(accent):
    color = closest_folder_color(accent)
    marker = FOLDER_THEME / ".folder-color"
    if marker.exists() and marker.read_text() == color:
        return
    directories = []
    for places in sorted(PAPIRUS.glob("*/places")):
        target_dir = FOLDER_THEME / places.parent.name / "places"
        target_dir.mkdir(parents=True, exist_ok=True)
        for old_link in target_dir.iterdir():
            old_link.unlink()
        for entry in places.iterdir():
            if not entry.is_symlink():
                continue
            default_target = os.readlink(entry)
            for _ in range(3):
                if "-blue" in default_target or not (places / default_target).is_symlink():
                    break
                default_target = os.readlink(places / default_target)
            if "-blue" not in default_target:
                continue
            colored = places / default_target.replace("-blue", f"-{color}", 1)
            if colored.exists():
                (target_dir / entry.name).symlink_to(colored)
        directories.append(places.parent.name)
    def section(directory):
        size, _, scale = directory.partition("@")
        pixels = size.split("x")[0] if "x" in size else "16"
        scale_line = f"Scale={scale.rstrip('x')}\n" if scale else ""
        kind = "Scalable" if directory == "symbolic" else "Fixed"
        return f"\n[{directory}/places]\nContext=Places\nSize={pixels}\n{scale_line}Type={kind}\n"
    sections = "".join(section(directory) for directory in directories)
    write(FOLDER_THEME / "index.theme",
          "[Icon Theme]\nName=Papirus-Rice\nComment=Papirus-Dark with wallpaper-coloured folders\nInherits=Papirus-Dark,Papirus,hicolor\n"
          f"Directories={','.join(f'{size}/places' for size in directories)}\n{sections}")
    marker.write_text(color)
    subprocess.run(["gtk-update-icon-cache", "-f", "-q", str(FOLDER_THEME)], check=False, capture_output=True)


def slurp_args(p):
    return " ".join([
        f"-b {p['base'].bare(0.35)}",
        f"-c {p['petal'].bare(1.0)}",
        f"-s {p['petal'].bare(0.12)}",
        f"-B {p['petal'].bare(0.18)}",
        "-w 2",
    ]) + "\n"


