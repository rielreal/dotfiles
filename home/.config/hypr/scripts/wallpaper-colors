MIN_HUE_DISTANCE = 0.06
GRAYSCALE_SATURATION = 0.12


class Color:
    def __init__(self, hue, lightness, saturation):
        self.hue = hue % 1.0
        self.lightness = min(max(lightness, 0.0), 1.0)
        self.saturation = min(max(saturation, 0.0), 1.0)

    @classmethod
    def from_rgb(cls, red, green, blue):
        hue, lightness, saturation = colorsys.rgb_to_hls(red / 255, green / 255, blue / 255)
        return cls(hue, lightness, saturation)

    def tone(self, lightness, saturation):
        return Color(self.hue, lightness, saturation)

    def rgb(self):
        red, green, blue = colorsys.hls_to_rgb(self.hue, self.lightness, self.saturation)
        return round(red * 255), round(green * 255), round(blue * 255)

    def hex(self, alpha=None):
        value = "#{:02x}{:02x}{:02x}".format(*self.rgb())
        return value if alpha is None else value + "{:02x}".format(round(alpha * 255))

    def bare(self, alpha=1.0):
        return "{:02x}{:02x}{:02x}{:02x}".format(*self.rgb(), round(alpha * 255))

    def rgba(self, alpha):
        return "rgba({}, {}, {}, {})".format(*self.rgb(), alpha)


def sample_colors(image):
    histogram = subprocess.run(
        ["magick", f"{image}[0]", "-resize", "160x160", "-colors", "16", "-format", "%c", "histogram:info:-"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
    samples = []
    for line in histogram.splitlines():
        match = re.search(r"^\s*(\d+):.*#([0-9A-Fa-f]{6})", line)
        if match:
            count = int(match.group(1))
            red, green, blue = (int(match.group(2)[i:i + 2], 16) for i in (0, 2, 4))
            samples.append((count, Color.from_rgb(red, green, blue)))
    if not samples:
        sys.exit(f"wallpaper-colors: no colors sampled from {image}")
    return samples


def hue_distance(first, second):
    distance = abs(first.hue - second.hue)
    return min(distance, 1.0 - distance)


def dominant_hue(samples):
    x = sum(count * color.saturation * math.cos(2 * math.pi * color.hue) for count, color in samples)
    y = sum(count * color.saturation * math.sin(2 * math.pi * color.hue) for count, color in samples)
    return math.atan2(y, x) / (2 * math.pi)


def pick_accents(samples):
    vivid = [(count, color) for count, color in samples if 0.2 < color.lightness < 0.85]
    ranked = sorted(vivid or samples, key=lambda item: item[1].saturation * item[0] ** 0.35, reverse=True)
    accents = []
    for _, color in ranked:
        if all(hue_distance(color, chosen) > MIN_HUE_DISTANCE for chosen in accents):
            accents.append(color)
        if len(accents) == 3:
            break
    primary = accents[0]
    while len(accents) < 3:
        accents.append(Color(primary.hue + 0.07 * len(accents), primary.lightness, primary.saturation))
    return accents


def build_palette(samples):
    accents = pick_accents(samples)
    primary = accents[0]
    grayscale = primary.saturation < GRAYSCALE_SATURATION
    accent_saturation = 0.12 if grayscale else None
    base_hue = primary.hue if grayscale else dominant_hue(samples)

    def accent(color, lightness):
        saturation = accent_saturation if grayscale else min(max(color.saturation, 0.68), 0.9)
        return color.tone(lightness, saturation)

    tint = 0.04 if grayscale else 0.3
    base = Color(base_hue, 0.06, tint)
    return {
        "base": base,
        "critical": Color(primary.hue, 0.11, tint + 0.2),
        "petal": accent(accents[0], 0.68),
        "ember": accent(accents[1], 0.70),
        "gold": accent(accents[2], 0.76),
        "wine": accent(accents[0], 0.38),
        "blush": primary.tone(0.82, 0.12 if grayscale else 0.45),
        "text": primary.tone(0.93, 0.08 if grayscale else 0.3),
        "soft": primary.tone(0.78, 0.06 if grayscale else 0.18),
        "muted": primary.tone(0.58, 0.05 if grayscale else 0.12),
    }


def write(path, content):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(content)
    temporary.replace(path)


def waybar_css(p):
    return "".join([
        f"@define-color glass {p['base'].rgba(0.38)};\n",
        f"@define-color pill {p['text'].rgba(0.07)};\n",
        f"@define-color pillHover {p['text'].rgba(0.14)};\n",
        f"@define-color edge {p['petal'].rgba(0.28)};\n",
        *(f"@define-color {name} {p[name].hex()};\n" for name in ("text", "muted", "blush", "petal", "ember", "gold", "wine")),
    ])


