    }
    return ":root {\n" + "".join(f"  --rice-{name}: {value};\n" for name, value in entries.items()) + "}\n"


def firefox_profiles():
    profiles = set()
    for root in FIREFOX_ROOTS:
        installs = configparser.ConfigParser()
        installs.read(root / "installs.ini")
        for section in installs.sections():
            profile = root / installs[section].get("Default", "")
            if profile != root and profile.is_dir():
                profiles.add(profile)
    return sorted(profiles)


def link_profile_file(link, source):
    if link.is_symlink() and link.resolve() == source.resolve():
        return
    if link.exists() and not link.is_symlink():
        print(f"wallpaper-colors: leaving existing {link} alone", file=sys.stderr)
        return
    link.unlink(missing_ok=True)
    link.symlink_to(source)


def copy_into_sandbox(target, source):
    temporary = target.with_name(target.name + ".tmp")
    shutil.copyfile(source, temporary)
    temporary.replace(target)


def render_firefox(p):
    colors = firefox_colors(p)
    for profile in firefox_profiles():
        chrome = profile / "chrome"
        write(chrome / "rice-colors.css", colors)
        for name in ("userChrome.css", "userContent.css"):
            copy_into_sandbox(chrome / name, FIREFOX_THEME / name)
        copy_into_sandbox(chrome / "wallpaper", WALLPAPER_LINK)
        link_profile_file(profile / "user.js", FIREFOX_THEME / "user.js")


