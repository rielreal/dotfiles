def kitty_conf(p):
    background = p["base"].tone(0.1, min(p["base"].saturation, 0.25))
    foreground = p["text"].tone(0.84, min(p["text"].saturation, 0.12))
    surface = background.tone(0.18, background.saturation)
    selection = p["petal"].tone(0.3, 0.35)
    return "".join(f"{key} {value}\n" for key, value in [
        ("background", background.hex()),
        ("foreground", foreground.hex()),
        ("cursor", p["petal"].hex()),
        ("cursor_text_color", background.hex()),
        ("selection_background", selection.hex()),
        ("selection_foreground", foreground.hex()),
        ("url_color", p["petal"].hex()),
        ("active_border_color", p["petal"].hex()),
        ("inactive_border_color", p["wine"].hex()),
        ("tab_bar_background", background.hex()),
        ("active_tab_background", background.hex()),
        ("active_tab_foreground", p["petal"].hex()),
        ("inactive_tab_background", background.hex()),
        ("inactive_tab_foreground", p["muted"].hex()),
        ("color0", surface.hex()),
        ("color8", p["muted"].hex()),
        ("color3", p["gold"].hex()),
        ("color11", p["gold"].hex()),
        ("color5", p["petal"].hex()),
        ("color13", p["petal"].hex()),
        ("color7", p["soft"].hex()),
        ("color15", foreground.hex()),
    ])


