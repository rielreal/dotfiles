def recolor(text, replacements):
    pattern = re.compile("|".join(re.escape(key) for key in replacements), re.IGNORECASE)
    return pattern.sub(lambda match: replacements[match.group(0).lower()], text)


def render_gtk_theme(replacements):
    for version in ("gtk-3.0", "gtk-4.0"):
        source = GTK_TEMPLATE / version
        target = GTK_THEME / version
        target.mkdir(parents=True, exist_ok=True)
        assets = target / "assets"
        if not (assets.is_symlink() and assets.resolve() == (source / "assets").resolve()):
            assets.unlink(missing_ok=True)
            assets.symlink_to(source / "assets")
        for stylesheet in ("gtk.css", "gtk-dark.css"):
            write(target / stylesheet, recolor((source / stylesheet).read_text(), replacements))
    write(GTK_THEME / "index.theme", "[Desktop Entry]\nType=X-GNOME-Metatheme\nName=Rice\n\n[X-GNOME-Metatheme]\nGtkTheme=Rice\n")


def render_kvantum_theme(replacements):
    write(KVANTUM_THEME / "Rice.svg", recolor((KVANTUM_TEMPLATE / "RosePine.svg").read_text(), replacements))
    write(KVANTUM_THEME / "Rice.kvconfig", recolor((KVANTUM_TEMPLATE / "RosePine.kvconfig").read_text(), replacements))


def hyprland_borders(p):
    return {
        "borderActive": f"rgba({p['petal'].bare()}) rgba({p['ember'].bare()}) 45deg",
        "borderInactive": f"rgba({p['wine'].bare(0.8)}) rgba({p['muted'].bare(0.8)}) 45deg",
        "groupActive": f"rgba({p['wine'].bare(0.93)})",
        "groupInactive": f"rgba({p['base'].bare(0.93)})",
        "groupText": f"rgba({p['text'].bare(0.93)})",
    }


def app_surfaces(p):
    app = p["base"].tone(0.1, min(p["base"].saturation, 0.25))
    return {lightness: app.tone(lightness, app.saturation * 0.8) for lightness in (0.07, 0.08, 0.1, 0.12, 0.14, 0.17, 0.2, 0.27)}


def spicetify_ini(p):
    s = app_surfaces(p)
    entries = [
        ("text", p["text"]), ("subtext", p["soft"]), ("main", s[0.12]), ("main-elevated", s[0.17]),
        ("main-transition", s[0.1]), ("highlight", s[0.2]), ("highlight-elevated", s[0.17]),
        ("sidebar", s[0.1]), ("player", s[0.08]), ("card", s[0.08]), ("shadow", s[0.07]),
        ("selected-row", p["text"]), ("button", p["petal"]), ("button-active", p["ember"]),
        ("button-disabled", s[0.27]), ("tab-active", s[0.17]), ("notification", p["wine"]),
        ("notification-error", p["petal"]), ("misc", s[0.07]), ("play-button", p["petal"]),
        ("play-button-active", p["ember"]), ("progress-fg", p["petal"]), ("progress-bg", s[0.27]),
        ("heart", p["petal"]), ("pagelink-active", p["ember"]), ("radio-btn-active", p["petal"]),
    ]
    return "[Rice]\n" + "".join(f"{key:<19}= {color.hex()[1:]}\n" for key, color in entries)


