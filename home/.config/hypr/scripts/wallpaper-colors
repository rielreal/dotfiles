def render_sddm(p):
    wallpaper = WALLPAPER_LINK.resolve()
    background = SDDM_STATE / ("background" + wallpaper.suffix.lower())
    for stale in SDDM_STATE.glob("background.*"):
        if stale != background:
            stale.unlink()
    copy_into_sandbox(background, wallpaper)
    write(SDDM_STATE / "theme.conf.user", sddm_conf(p, str(background)))


