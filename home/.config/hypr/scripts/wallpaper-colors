def vscode_tokens(p):
    def rule(scopes, color, style=None):
        settings = {"foreground": color.hex()}
        if style:
            settings["fontStyle"] = style
        return {"scope": scopes, "settings": settings}
    return {"textMateRules": [
        rule(["comment", "punctuation.definition.comment"], p["muted"], "italic"),
        rule(["string", "string.quoted", "string.template"], p["gold"]),
        rule(["constant.numeric", "constant.language", "constant.character", "support.constant"], p["ember"]),
        rule(["keyword", "storage", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"], p["petal"]),
        rule(["entity.name.function", "support.function", "meta.function-call"], p["blush"]),
        rule(["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], p["ember"]),
        rule(["variable", "variable.other", "meta.definition.variable"], p["text"]),
        rule(["variable.parameter"], p["soft"], "italic"),
        rule(["entity.name.tag"], p["petal"]),
        rule(["entity.other.attribute-name"], p["gold"]),
        rule(["punctuation", "meta.brace"], p["soft"]),
    ]}


def render_vscode(p):
    try:
        settings = json.loads(VSCODE_SETTINGS.read_text())
    except json.JSONDecodeError as error:
        print(f"wallpaper-colors: skipping VS Code, {VSCODE_SETTINGS} is not plain JSON ({error})", file=sys.stderr)
        return
    settings["workbench.colorTheme"] = "Default Dark Modern"
    settings["workbench.colorCustomizations"] = vscode_colors(p)
    settings["editor.tokenColorCustomizations"] = vscode_tokens(p)
    write(VSCODE_SETTINGS, json.dumps(settings, indent=4) + "\n")


def hue_family(color):
    degrees = color.hue * 360
    for limit, family in ((15, "red"), (45, "orange"), (70, "yellow"), (165, "green"), (195, "cyan"), (255, "blue"), (345, "purple")):
        if degrees < limit:
            return family
    return "red"


def jetbrains_recolor(match, p, syntax):
    value, alpha = match.group(1), match.group(2) or ""
    color = Color.from_rgb(*(int(value[i:i + 2], 16) for i in (0, 2, 4)))
    if color.saturation < 0.15 or color.lightness < 0.04:
        tint = min(p["base"].saturation, 0.25) * (0.8 if color.lightness < 0.5 else 0.4)
        recolored = Color(p["base"].hue, color.lightness, tint)
    else:
        family = hue_family(color)
        foreground_roles = {
            "orange": p["petal"], "green": p["gold"], "blue": p["blush"], "purple": p["ember"],
            "cyan": p["ember"].tone(0.8, p["ember"].saturation), "yellow": p["gold"].tone(0.66, p["gold"].saturation),
        }
        if syntax and color.lightness >= 0.4 and family in foreground_roles:
            recolored = foreground_roles[family]
        elif family in ("blue", "purple"):
            recolored = Color(p["petal"].hue, color.lightness, min(color.saturation, p["petal"].saturation))
        else:
            return match.group(0)
    prefix = "#" if match.group(0).startswith("#") else ""
    return prefix + recolored.hex()[1:].upper() + alpha


def recolor_json_value(value, p):
    if isinstance(value, dict):
        return {key: recolor_json_value(item, p) for key, item in value.items()}
    if isinstance(value, str) and value.startswith("#") and HEX_COLOR.match(value):
        return HEX_COLOR.sub(lambda match: jetbrains_recolor(match, p, False), value)
    return value


def intellij_theme(p):
    islands = json.loads((INTELLIJ_TEMPLATES / "islands-dark.theme.json").read_text())
    parent_colors = json.loads((INTELLIJ_TEMPLATES / "expui-dark.theme.json").read_text())["colors"]
    theme = recolor_json_value(islands, p)
    theme["name"] = "Rice"
    theme["author"] = "wallpaper-colors"
    theme["editorScheme"] = "/rice.xml"
    theme["colors"] = {**recolor_json_value(parent_colors, p), **theme["colors"], "ForegroundDefault": p["text"].hex()}
    return json.dumps(theme, indent=2)


def intellij_scheme(p):
    scheme = (INTELLIJ_TEMPLATES / "islands-dark-scheme.xml").read_text()
    scheme = scheme.replace('<scheme name="Islands Dark"', '<scheme name="Rice"', 1)
    value = re.compile(r'(value=")([0-9A-Fa-f]{6})(")')
    return value.sub(lambda match: match.group(1) + HEX_COLOR.sub(lambda inner: jetbrains_recolor(inner, p, True), match.group(2)) + match.group(3), scheme)


def render_intellij(p):
    theme, scheme = intellij_theme(p), intellij_scheme(p)
    for data_dir in sorted(JETBRAINS_DATA.glob("IntelliJIdea*")):
        jar = data_dir / "rice-theme/lib/rice-theme.jar"
        jar.parent.mkdir(parents=True, exist_ok=True)
        temporary = jar.with_name(jar.name + ".tmp")
        with zipfile.ZipFile(temporary, "w", zipfile.ZIP_DEFLATED) as archive:
            archive.writestr("META-INF/plugin.xml", INTELLIJ_PLUGIN_XML)
            archive.writestr("rice.theme.json", theme)
            archive.writestr("rice.xml", scheme)
        temporary.replace(jar)


def telegram_color(value, alpha, p):
    color = Color.from_rgb(*(int(value[i:i + 2], 16) for i in (0, 2, 4)))
    tint = min(p["base"].saturation, 0.25)
    translucent = bool(alpha) and alpha.lower() != "ff"
    if color.saturation < 0.15:
        lightness = 0.08 + (1 - color.lightness) * 0.85
        return Color(p["base"].hue, lightness, tint * (0.5 if lightness < 0.5 else 0.3))
    family = hue_family(color)
    if family not in ("blue", "cyan", "purple", "green"):
        return color
    hue = p["ember"].hue if family == "green" else p["petal"].hue
    if color.lightness > 0.8:
        return Color(hue, 1.08 - color.lightness, min(color.saturation, 0.35))
    if translucent or color.lightness < 0.35:
        return Color(hue, min(color.lightness, 0.22), min(color.saturation, 0.35))
    return Color(hue, max(color.lightness, 0.6), min(color.saturation, p["petal"].saturation))


def telegram_palette(p):
    lines = []
    for name, value, alpha in TELEGRAM_COLOR_LINE.findall(TELEGRAM_PALETTE.read_text()):
        if name.startswith(TELEGRAM_KEPT_PREFIXES):
            continue
        lines.append(f"{name}: {telegram_color(value, alpha, p).hex()}{alpha or ''};")
    return "\n".join(lines) + "\n"


def render_telegram(p):
    background = subprocess.run(
        ["magick", f"{WALLPAPER_LINK.resolve()}[0]", "-resize", "1920x1080^", "-fill", app_surfaces(p)[0.08].hex(), "-colorize", "45%", "-quality", "88", "jpg:-"],
        check=True,
        capture_output=True,
    ).stdout
    temporary = TELEGRAM_THEME.with_name(TELEGRAM_THEME.name + ".tmp")
    with zipfile.ZipFile(temporary, "w", zipfile.ZIP_DEFLATED) as archive:
        archive.writestr("colors.tdesktop-theme", telegram_palette(p))
        archive.writestr("background.jpg", background)
    temporary.replace(TELEGRAM_THEME)


def kde_color_sets(p):
    s = app_surfaces(p)
    rgb = lambda color: ",".join(str(channel) for channel in color.rgb())
    selection = p["petal"].tone(0.4, min(p["petal"].saturation, 0.55))
    foregrounds = {
        "ForegroundNormal": rgb(p["text"]),
        "ForegroundInactive": rgb(p["muted"]),
        "ForegroundActive": rgb(p["petal"]),
        "ForegroundLink": rgb(p["petal"]),
        "ForegroundVisited": rgb(p["ember"]),
        "ForegroundNegative": rgb(Color(0.0, 0.66, 0.7)),
        "ForegroundNeutral": rgb(p["gold"]),
        "ForegroundPositive": rgb(Color(0.36, 0.62, 0.45)),
        "DecorationFocus": rgb(p["petal"]),
        "DecorationHover": rgb(p["blush"]),
    }
    def colour_set(normal, alternate):
        return {"BackgroundNormal": rgb(normal), "BackgroundAlternate": rgb(alternate), **foregrounds}
    return {
        "Colors:View": colour_set(s[0.1], s[0.12]),
        "Colors:Window": colour_set(s[0.08], s[0.1]),
        "Colors:Button": colour_set(s[0.14], s[0.17]),
        "Colors:Tooltip": colour_set(s[0.12], s[0.14]),
        "Colors:Complementary": colour_set(s[0.08], s[0.1]),
        "Colors:Header": colour_set(s[0.08], s[0.1]),
        "Colors:Header][Inactive": colour_set(s[0.08], s[0.1]),
        "Colors:Selection": {**colour_set(selection, selection.tone(0.36, selection.saturation)), "ForegroundNormal": rgb(p["text"]), "ForegroundInactive": rgb(p["soft"])},
        "WM": {
            "activeBackground": rgb(s[0.08]), "activeForeground": rgb(p["text"]), "activeBlend": rgb(p["petal"]),
            "inactiveBackground": rgb(s[0.08]), "inactiveForeground": rgb(p["muted"]), "inactiveBlend": rgb(p["muted"]),
        },
    }


def render_kde(p):
    for group, entries in kde_color_sets(p).items():
        for key, value in entries.items():
            subprocess.run(["kwriteconfig6", "--file", "kdeglobals", *[arg for part in group.split("][") for arg in ("--group", part)], "--key", key, value], check=True)
    subprocess.run(["kwriteconfig6", "--file", "kdeglobals", "--group", "General", "--key", "ColorScheme", "Rice"], check=True)
    subprocess.run(["kwriteconfig6", "--file", "kdeglobals", "--group", "UiSettings", "--key", "ColorScheme", "Rice"], check=True)


def render_fastfetch(p):
    temporary = FASTFETCH_LOGO.with_name("fastfetch-logo.tmp.png")
    subprocess.run(["vipsthumbnail", str(WALLPAPER_LINK.resolve()), "--smartcrop", "attention", "-s", "480x480", "-o", str(temporary)], check=True, capture_output=True)
    temporary.replace(FASTFETCH_LOGO)
    rule = p["petal"].tone(0.38, min(p["petal"].saturation, 0.45))
    tokens = {
        "petal": p["petal"].hex(), "ember": p["ember"].hex(), "gold": p["gold"].hex(), "blush": p["blush"].hex(),
        "muted": p["muted"].hex(), "text": p["text"].hex(), "rule": ";".join(str(channel) for channel in rule.rgb()),
        "logo": str(FASTFETCH_LOGO),
    }
    config = FASTFETCH_TEMPLATE.read_text()
    for name, value in tokens.items():
        config = config.replace("{{" + name + "}}", value)
    write(FASTFETCH_CONFIG, config)


def apply_live(borders):
    subprocess.run(["pkill", "-SIGUSR2", "-x", "waybar"], check=False)
    subprocess.run(["dunstctl", "reload"], check=False, capture_output=True)
    subprocess.run(["pkill", "-USR1", "-x", "kitty"], check=False)
    runtime = Path(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"))
    for socket in runtime.glob("pcdeck-kitty-*.sock"):
        subprocess.run(["kitten", "@", "--to", f"unix:{socket}", "set-colors", "--all", "--configured", str(STATE_DIR / "kitty-colors.conf")], check=False, capture_output=True, timeout=5)
    batch = "; ".join([
        f"keyword general:col.active_border {borders['borderActive']}",
        f"keyword general:col.inactive_border {borders['borderInactive']}",
        f"keyword group:col.border_active {borders['borderActive']}",
        f"keyword group:col.border_inactive {borders['borderInactive']}",
        f"keyword group:groupbar:col.active {borders['groupActive']}",
        f"keyword group:groupbar:col.inactive {borders['groupInactive']}",
    ])
    subprocess.run(["hyprctl", "--batch", batch], check=False, capture_output=True)
    if shutil.which("spicetify"):
        subprocess.run(["spicetify", "refresh", "-n"], check=False, capture_output=True)
    for theme in ("Adwaita-dark", "Rice"):
        subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", theme], check=False)


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: wallpaper-colors <image>")
    palette = build_palette(sample_colors(sys.argv[1]))
    borders = hyprland_borders(palette)
    write(WAYBAR_COLORS, waybar_css(palette))
    write(SWAYOSD_COLORS, waybar_css(palette))
    write(STATE_DIR / "colors.rasi", rofi_rasi(palette))
    write(STATE_DIR / "hyprland-colors.conf", "".join(f"${name} = {value}\n" for name, value in borders.items()))
    write(STATE_DIR / "kitty-colors.conf", kitty_conf(palette))
    write(STATE_DIR / "hyprlock-colors.conf", hyprlock_colors(palette))
    write(DUNST_DROPIN, dunst_conf(palette))
    write(BTOP_THEME, btop_theme(palette))
    write(STATE_DIR / "slurp-args", slurp_args(palette))
    write(SATTY_DIR / "config.toml", satty_config(palette))
    write(SATTY_DIR / "overrides.css", satty_css(palette))
    if PAPIRUS.is_dir():
        render_folder_theme(palette["petal"])
    if SPICETIFY_COLORS.parent.is_dir():
        write(SPICETIFY_COLORS, spicetify_ini(palette))
    if VESKTOP_QUICKCSS.parent.parent.is_dir():
        write(VESKTOP_QUICKCSS, vesktop_css(palette))
    if FIREFOX_THEME.is_dir():
        render_firefox(palette)
    if SDDM_STATE.is_dir() and os.access(SDDM_STATE, os.W_OK):
        render_sddm(palette)
    if VSCODE_SETTINGS.exists():
        render_vscode(palette)
    if INTELLIJ_TEMPLATES.is_dir():
        render_intellij(palette)
    if FASTFETCH_TEMPLATE.exists() and shutil.which("vipsthumbnail"):
        render_fastfetch(palette)
    if TELEGRAM_PALETTE.exists():
        render_telegram(palette)
    if shutil.which("kwriteconfig6"):
        render_kde(palette)
    replacements = rose_pine_replacements(palette)
    render_gtk_theme(replacements)
    render_kvantum_theme(replacements)
    apply_live(borders)


if __name__ == "__main__":
    main()
