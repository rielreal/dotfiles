def brand_ramp(accent):
    shades = {100: 0.9, 130: 0.88, 160: 0.86, 200: 0.84, 230: 0.82, 260: 0.8, 300: 0.78, 330: 0.76, 345: 0.75, 360: 0.74, 400: 0.72, 430: 0.7,
              460: 0.68, 500: 0.66, 530: 0.62, 560: 0.58, 600: 0.54, 630: 0.5, 660: 0.46, 700: 0.42, 730: 0.38, 760: 0.34, 800: 0.3, 830: 0.26, 860: 0.22, 900: 0.18}
    return {f"--brand-{shade}": accent.tone(lightness, accent.saturation).hex() for shade, lightness in shades.items()}


def semantic_ramps():
    hues = {"red": (25, 0.13), "green": (160, 0.075), "yellow": (80, 0.1), "blue": (230, 0.08), "purple": (320, 0.09)}
    lightness = (78, 73, 68, 63, 58)
    return {f"--{name}-{index}": f"oklch({level}% {chroma} {hue})" for name, (hue, chroma) in hues.items() for index, level in enumerate(lightness, start=1)}


def vesktop_css(p):
    s = app_surfaces(p)
    petal = p["petal"]
    accents = {f"--accent-{index}": petal.tone(lightness, petal.saturation).hex() for index, lightness in enumerate((0.78, 0.7, 0.64, 0.58, 0.52), start=1)}
    colors = {
        "--colors": "on",
        "--text-0": s[0.08].hex(),
        "--text-1": p["text"].hex(),
        "--text-2": p["soft"].hex(),
        "--text-3": p["soft"].tone(0.66, p["soft"].saturation).hex(),
        "--text-4": p["muted"].hex(),
        "--text-5": p["muted"].tone(0.4, p["muted"].saturation).hex(),
        "--bg-1": s[0.2].hex(),
        "--bg-2": s[0.17].hex(),
        "--bg-3": s[0.08].hex(),
        "--bg-4": s[0.12].hex(),
        "--bg-floating": s[0.14].hex(),
        "--hover": p["text"].rgba(0.06),
        "--active": petal.rgba(0.14),
        "--active-2": petal.rgba(0.22),
        "--message-hover": "rgba(0, 0, 0, 0.12)",
        **accents,
        "--accent-new": accents["--accent-2"],
        **semantic_ramps(),
        **brand_ramp(petal),
        "--text-brand": accents["--accent-1"],
        "--brand-experiment": accents["--accent-2"],
    }
    color_block = ":root {\n" + MIDNIGHT_STATIC_COLORS + "".join(f"    {name}: {value};\n" for name, value in colors.items()) + "}\n"
    return "@import url('https://refact0r.github.io/midnight-discord/build/midnight.css');\n" + MIDNIGHT_OPTIONS + color_block + VESKTOP_DECLUTTER


