[global]
monitor = 0
follow = mouse
layer = overlay
origin = top-right
offset = (14, 14)
width = (360, 460)
height = (0, 260)
notification_limit = 6
gap_size = 8
padding = 16
horizontal_padding = 18
text_icon_padding = 16
frame_width = 1
frame_color = "#f2727f55"
separator_height = 0
corner_radius = 14
icon_corner_radius = 10

font = Rubik 11
markup = full
format = "<span size='small' foreground='#9a7f85'>%a</span>\n<b>%s</b>\n%b"
alignment = left
vertical_alignment = center
line_height = 2
word_wrap = yes
ellipsize = end
ignore_newline = no
show_age_threshold = 120
stack_duplicates = true
hide_duplicate_count = false
show_indicators = no

icon_theme = "Papirus-Rice, hicolor"
enable_recursive_icon_lookup = true
icon_position = left
min_icon_size = 52
max_icon_size = 60

progress_bar = true
progress_bar_height = 7
progress_bar_frame_width = 0
progress_bar_min_width = 260
progress_bar_max_width = 420
progress_bar_corner_radius = 3
highlight = "#f2727f"

sticky_history = yes
history_length = 30
dmenu = /usr/bin/rofi -dmenu -p dunst
browser = /usr/bin/xdg-open
mouse_left_click = do_action, close_current
mouse_middle_click = close_all
mouse_right_click = close_current

[urgency_low]
background = "#140c10a8"
foreground = "#c9b3b6"
frame_color = "#9a7f8540"
timeout = 5

[urgency_normal]
background = "#140c10b4"
foreground = "#f3e6e4"
timeout = 5

[urgency_critical]
background = "#2a0f16cc"
foreground = "#f3e6e4"
frame_color = "#f2727f"
highlight = "#f4956a"
timeout = 5
